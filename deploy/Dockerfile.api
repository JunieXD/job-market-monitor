FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10

WORKDIR /app

RUN useradd --create-home --uid 10002 api

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

# The API imports the shared package but never launches a browser. Keeping
# this image separate prevents an API rebuild from downloading Chromium.
RUN pip install --no-cache-dir "setuptools>=75" \
    && pip install --no-cache-dir --no-build-isolation .

USER api

ENTRYPOINT ["uvicorn"]
CMD ["job_market.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
