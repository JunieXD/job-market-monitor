[Unit]
Description=Job Market Monitor daily crawl
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/job-market-monitor
Environment=SOURCE_TIMEOUT_SECONDS=10800
Environment=MAX_ATTEMPTS=2
Environment=RETRY_DELAY_SECONDS=60
Environment=MAX_PARALLEL_SOURCES=2
Environment=SOURCE_START_DELAY_SECONDS=3
ExecStart=/opt/job-market-monitor/deploy/run-scheduled-crawls.sh
TimeoutStartSec=23h
TimeoutStopSec=2m
KillMode=control-group
